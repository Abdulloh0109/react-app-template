# Base URL of your REST API. Used by the axios instance in src/lib/api/axios.ts
VITE_BASE_URL="https://api.example.com/"

# When "true", all requests are served from the in-memory mock layer
# (src/mocks). Set to "false" once a real backend is wired up.
VITE_USE_MOCK="true"

# Simulated latency for the mock layer, in milliseconds. Useful for seeing
# loading states; set to 0 to remove the delay.
VITE_MOCK_DELAY="350"
